<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_parent_background">

    <androidx.cardview.widget.CardView
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_parent_background"
            android:gravity="center">

            <TextView
                android:id="@+id/txtDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Pick a Time"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                app:layout_constraintEnd_toEndOf="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                app:layout_constraintStart_toStartOf="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Inbuilt TimePicker -->

            <TimePicker
                android:id="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/dialog_parent_background"
                android:timePickerMode="spinner"
                app:layout_constraintBottom_toTopOf="@+id/buttonCustomerBandBookNowPickEventStartTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtDialogTitle" />

            <Button
                android:id="@+id/buttonCustomerBandBookNowPickEventStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                android:text="Set Time"
                android:textColor="@color/vibrant_pinkish_red"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                app:layout_constraintStart_toStartOf="@+id/timePickerCustomerBandBookNowPickEventStartTime"
                app:layout_constraintTop_toBottomOf="@+id/timePickerCustomerBandBookNowPickEventStartTime" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>