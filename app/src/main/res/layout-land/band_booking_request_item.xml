<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textColor="@color/vibrant_red"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/textViewBandBookingRequestItemViewLocationButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCustomerEmailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="@string/band_booking_request_item_customer_email"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerName" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCustomerEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/vibrant_red"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textViewBandBookingRequestItemCustomerEmailTitle"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerName" />

            <ImageView
                android:id="@+id/textViewBandBookingRequestItemViewLocationButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_location"
                app:tint="@color/vibrant_red" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCustomerMobileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/band_booking_request_item_customer_mobile"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerEmailTitle" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCustomerMobile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/vibrant_red"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textViewBandBookingRequestItemCustomerMobileTitle"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerEmail" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemEventStartDateTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/band_booking_request_item_event_start_date_time"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerMobileTitle" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemEventStartDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/vibrant_red"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textViewBandBookingRequestItemEventStartDateTimeTitle"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCustomerMobile" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemEventEndDateTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/band_booking_request_item_event_end_date_time"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemEventStartDateTimeTitle" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemEventEndDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/vibrant_red"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textViewBandBookingRequestItemEventEndDateTimeTitle"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemEventStartDateTime" />

            <TextView
                android:id="@+id/textViewBandBookingRequestAcceptButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:drawableRight="@drawable/ic_verify"
                android:drawablePadding="5dp"
                android:drawableTint="@color/vibrant_red"
                android:text="@string/band_booking_request_accept_button"
                android:textColor="@color/vibrant_pinkish_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textViewBandBookingRequestDeclineButton"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemCallNowButton" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemCallNowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:drawableRight="@drawable/ic_call"
                android:drawablePadding="5dp"
                android:text="@string/band_booking_request_item_call_now_button"
                android:textSize="18sp"
                android:textStyle="bold"
                app:drawableTint="@color/vibrant_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemEventEndDateTime" />

            <TextView
                android:id="@+id/textViewBandBookingRequestItemMessageNowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:drawableLeft="@drawable/ic_menu_messages"
                android:drawablePadding="5dp"
                android:drawableTint="@color/vibrant_red"
                android:text="@string/band_booking_request_item_message_now_button"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemEventEndDateTimeTitle" />

            <TextView
                android:id="@+id/textViewBandBookingRequestDeclineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:drawableRight="@drawable/ic_void"
                android:drawablePadding="5dp"
                android:drawableTint="@color/blue"
                android:text="Decline"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/textViewBandBookingRequestAcceptButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewBandBookingRequestItemMessageNowButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>